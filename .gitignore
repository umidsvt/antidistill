# Model checkpoints and training artifacts
saves/
logs/
wandb/
nohup.out
*.pid
*_server.log

# Generated datasets. Large regenerable pools stay out; the defended datasets are small
# (~4MB) and cost hours of multi-GPU time to produce, so they ARE committed — and being
# model-independent they are directly reusable for other student models.
data/raw/*.json
data/curated/*.json
data/defended/*.json
!data/defended/limo_hindsight_ds32b.json
!data/defended/limo_hindsight_ds32b.meta.json
data/defended/_shard*.json

# Eval artifacts
outputs/
third_party/kim_eval/outputs*/
third_party/kim_eval/completions/
third_party/kim_eval/.venv/

# Scoring artifacts
results/scoring/*.json
results/scoring/*.csv

# Python
__pycache__/
*.pyc
*.egg-info/
.venv*/

# Large binaries
*.ckpt
*.pt
*.pth
*.safetensors

# Host-specific interconnect settings — regenerate per machine with scripts/check_host.sh
.host_profile
